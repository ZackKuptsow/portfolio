# =============================
# 📦 Dependency Management
# =============================
**/node_modules/
.pnp/
.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions
!**/.yarn/sdks
!**/.yarnrc.yml

# =============================
# ⚙️ Build Output / Static Export
# =============================
/build/
**/build/
**/.next/
**/out/
.next/
out/
dist/
.temp/
.cache/
.vite/

# =============================
# 💻 TypeScript
# =============================
*.tsbuildinfo
.next/types/**/*.ts
next-env.d.ts

# =============================
# 🧪 Testing
# =============================
/coverage/
**/coverage/
# What Playwright writes when a browser check fails
**/playwright-report/
**/test-results/

# =============================
# 🔐 Environment Files
# =============================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# =============================
# 🧹 CDK / AWS
# =============================
cdk.out/
# Every context file stays out, send_resume's included: its hosted-zone entry carries the AWS
# account id, which a public repository should not publish. A deploy does one live lookup
# and rewrites the file locally; the tests pass without it (checked 2026-10-28).
cdk.context.json
**/*.assets.json
cdk*.log
cdk*.tsbuildinfo

# =============================
# 🎨 Prettier / ESLint
# =============================
.prettier-cache/
.eslintcache

# =============================
# 🐞 Debug / Logs
# =============================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================
# 👨‍💻 IDE / Editor
# =============================
.DS_Store
.idea/
.vscode/
.xcode.env
*.sublime-project
*.sublime-workspace

# =============================
# 📂 Miscellaneous
# =============================
*.pem
*.log
*.log.*

# =============================
# 🔀 Lock Files (if you're not using them)
# =============================
package-lock.json
pnpm-lock.yaml

# =============================
# 🧪 GitHub Actions / CI cache
# =============================
.github/workflows/node_modules/
